rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
             && request.auth.token.email in ['mohsin.dar@ddn.upes.ac.in'];
    }

    // =====================================================================
    // MCQ quizzes  —  quiz/
    // =====================================================================

    // Roster check, read server-side. Students never see this document.
    function onRoster(quizId, sapId) {
      return exists(/databases/$(database)/documents/quizKeys/$(quizId))
             && get(/databases/$(database)/documents/quizKeys/$(quizId))
                  .data.roster.hasAny([sapId]);
    }

    // Public quiz: questions WITHOUT correct answers.
    match /quizzes/{quizId} {
      allow read:  if request.auth != null;
      allow write: if isAdmin();
    }

    // Answer key + roster. Faculty only — never readable by a student.
    match /quizKeys/{quizId} {
      allow read, write: if isAdmin();
    }

    match /attempts/{attemptId} {
      // Faculty pressed "Allow resume" for a student who dropped off the
      // network. While this flag is set — and only while it is set — a browser
      // other than the one that started the attempt may open it.
      function resumeOpen() {
        return resource.data.get('resumeAllowed', false) == true;
      }

      // A student may read only their own attempt; faculty read everything.
      // `resource == null` must come first: a student starting a fresh attempt
      // reads a document that does not exist yet, and without this clause that
      // read is denied — which looks like "someone else already started".
      allow get: if isAdmin()
                 || resource == null
                 || (request.auth != null && resource.data.uid == request.auth.uid)
                 || (request.auth != null && resumeOpen());

      // Only faculty may list/query the collection. Students never need to.
      allow list: if isAdmin();

      // Starting an attempt: must be on the roster, must be tied to this browser,
      // must start unscored and in progress.
      allow create: if request.auth != null
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.status == 'in-progress'
                    && request.resource.data.score == null
                    && request.resource.data.graded == false
                    && request.resource.data.violations == 0
                    && onRoster(request.resource.data.quizId,
                                request.resource.data.sapId);

      // Taking over a granted resume: the ONLY way a different browser can
      // claim an attempt. It works exactly once — the same write spends the
      // grant — and it can change nothing except who owns the attempt.
      function claimResume() {
        return request.auth != null
               && resumeOpen()
               && resource.data.status == 'in-progress'
               && request.resource.data.uid == request.auth.uid
               && request.resource.data.resumeAllowed == false
               && request.resource.data.diff(resource.data).affectedKeys()
                    .hasOnly(['uid', 'resumeAllowed', 'lastSeenAt']);
      }

      // During/at the end of an attempt the student may only touch these fields,
      // may never score themselves, and may never reopen a submitted attempt.
      allow update: if isAdmin()
                    || claimResume()
                    || (request.auth != null
                        && resource.data.uid == request.auth.uid
                        && resource.data.status == 'in-progress'
                        && request.resource.data.uid == resource.data.uid
                        && request.resource.data.sapId == resource.data.sapId
                        && request.resource.data.startedAt == resource.data.startedAt
                        && request.resource.data.score == null
                        && request.resource.data.graded == false
                        && request.resource.data.violations >= resource.data.violations
                        && request.resource.data.status in ['in-progress', 'submitted']
                        && request.resource.data.diff(resource.data).affectedKeys()
                             .hasOnly(['answers', 'order', 'violations', 'violationLog',
                                       'lastSeenAt', 'status', 'submittedAt',
                                       'autoSubmitted', 'submitReason']));

      allow delete: if isAdmin();
    }

    // =====================================================================
    // Descriptive class tests  —  exam/
    // =====================================================================
    // Separate collections from the quiz, so the two systems cannot affect
    // each other. Same faculty account, same isAdmin() above.

    // Roster check, read server-side. `rosterOpen` is the deliberate escape
    // hatch for an invigilated room where no roster was prepared; it is set
    // from the dashboard and defaults to false.
    function examRosterOk(examId, sapId) {
      return exists(/databases/$(database)/documents/examKeys/$(examId))
             && (get(/databases/$(database)/documents/examKeys/$(examId))
                   .data.get('rosterOpen', false) == true
                 || get(/databases/$(database)/documents/examKeys/$(examId))
                      .data.get('roster', []).hasAny([sapId]));
    }

    // Public: the question paper. No model answers, no marking scheme.
    match /exams/{examId} {
      allow read:  if request.auth != null;
      allow write: if isAdmin();
    }

    // Marking scheme + roster. Faculty only — never readable by a student.
    match /examKeys/{examId} {
      allow read, write: if isAdmin();
    }

    match /examAttempts/{attemptId} {
      function resumeOpen() {
        return resource.data.get('resumeAllowed', false) == true;
      }

      allow get: if isAdmin()
                 || resource == null
                 || (request.auth != null && resource.data.uid == request.auth.uid)
                 || (request.auth != null && resumeOpen());

      allow list: if isAdmin();

      // Starting a paper: on the roster, tied to this browser, unmarked.
      allow create: if request.auth != null
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.status == 'in-progress'
                    && request.resource.data.score == null
                    && request.resource.data.graded == false
                    && request.resource.data.violations == 0
                    && examRosterOk(request.resource.data.examId,
                                    request.resource.data.sapId);

      function claimResume() {
        return request.auth != null
               && resumeOpen()
               && resource.data.status == 'in-progress'
               && request.resource.data.uid == request.auth.uid
               && request.resource.data.resumeAllowed == false
               && request.resource.data.diff(resource.data).affectedKeys()
                    .hasOnly(['uid', 'resumeAllowed', 'lastSeenAt']);
      }

      // While writing, a student may only touch these fields. Note what is
      // absent: `marks`, `feedback`, `score` and `graded` are outside the list,
      // so evaluation can only ever come from the dashboard.
      allow update: if isAdmin()
                    || claimResume()
                    || (request.auth != null
                        && resource.data.uid == request.auth.uid
                        && resource.data.status == 'in-progress'
                        && request.resource.data.uid == resource.data.uid
                        && request.resource.data.sapId == resource.data.sapId
                        && request.resource.data.startedAt == resource.data.startedAt
                        && request.resource.data.score == null
                        && request.resource.data.graded == false
                        && request.resource.data.violations >= resource.data.violations
                        && request.resource.data.status in ['in-progress', 'submitted']
                        && request.resource.data.diff(resource.data).affectedKeys()
                             .hasOnly(['answers', 'wordCounts', 'order', 'typedChars',
                                       'pasteAttempts', 'imageCount', 'violations',
                                       'violationLog', 'eventLog', 'lastSeenAt',
                                       'status', 'submittedAt', 'autoSubmitted',
                                       'submitReason']));

      allow delete: if isAdmin();

      // Uploaded diagrams: one document per picture, so the paper itself stays
      // small however much the student draws. Ownership is read from the parent
      // attempt rather than stored twice — which is also what carries the
      // pictures across when a granted resume moves the paper to a new device.
      match /images/{imageId} {
        function paper() {
          return get(/databases/$(database)/documents/examAttempts/$(attemptId)).data;
        }

        allow read: if isAdmin()
                    || (request.auth != null && paper().uid == request.auth.uid);

        // A picture can only be added to your own paper, only while it is still
        // open, and only if it fits: the 640 000-character ceiling keeps the
        // document under Firestore's 1 MiB limit even at the client's maximum
        // compressed size.
        allow create: if request.auth != null
                      && request.resource.data.uid == request.auth.uid
                      && paper().uid == request.auth.uid
                      && paper().status == 'in-progress'
                      && request.resource.data.dataUrl is string
                      && request.resource.data.dataUrl.size() < 640000;

        // A submitted diagram is evidence: the student cannot swap or delete it.
        allow update, delete: if isAdmin();
      }
    }

    // =====================================================================
    // Assignments  —  assignment/
    // =====================================================================
    // Students here sign in with a real account (email + password) rather
    // than an anonymous browser session: an assignment is worked on for days,
    // from more than one device, and by more than one person.
    //
    // Identity chain, checked on every write:
    //   account (uid) -> profile (SAP ID, fixed once set)
    //                 -> claim  assignStudents/{aid}__{sap}  (one account per SAP ID)
    //                 -> submission  assignSubs/{sid}  (members + their uids)
    // Every student write carries `actor` = the writer's SAP ID, and the rules
    // check that this account owns the claim on that SAP ID. So nobody can
    // type, declare or submit under a team-mate's name.
    //
    // All timing uses request.time (the server's clock), never the device's.

    function asgDoc(aid) {
      return get(/databases/$(database)/documents/assignments/$(aid)).data;
    }
    function asgKeyDoc(aid) {
      return get(/databases/$(database)/documents/assignmentKeys/$(aid)).data;
    }
    function claimPath(aid, sap) {
      return /databases/$(database)/documents/assignStudents/$(aid + '__' + sap);
    }
    function subPath(sid) {
      return /databases/$(database)/documents/assignSubs/$(sid);
    }
    function boardPath(aid) {
      return /databases/$(database)/documents/assignTopicBoards/$(aid);
    }
    // A student account: email/password sign-in, and not the faculty account.
    function isStudentAccount() {
      return request.auth != null
             && request.auth.token.firebase.sign_in_provider == 'password'
             && !isAdmin();
    }
    // This account holds the claim on SAP ID `sap` for assignment `aid`.
    function ownsClaim(aid, sap) {
      return sap is string
             && exists(claimPath(aid, sap))
             && get(claimPath(aid, sap)).data.uid == request.auth.uid;
    }
    // Open for new work: switched on, and before the deadline.
    function asgAccepting(aid) {
      return asgDoc(aid).active == true && request.time < asgDoc(aid).deadline;
    }
    function asgRosterOk(aid, sap) {
      return exists(/databases/$(database)/documents/assignmentKeys/$(aid))
             && (asgKeyDoc(aid).get('rosterOpen', false) == true
                 || asgKeyDoc(aid).get('roster', []).hasAny([sap]));
    }
    // Exact match on the part after "@", as the page checks it.
    function asgDomainOk(aid) {
      return asgDoc(aid).get('emailDomains', []).size() == 0
             || asgDoc(aid).get('emailDomains', [])
                  .hasAny([request.auth.token.email.split('@')[1]]);
    }

    // Public: the brief, the sections, the deadline. No marking scheme.
    match /assignments/{aid} {
      allow read:  if request.auth != null;
      allow write: if isAdmin();
    }

    // Roster + marking scheme. Faculty only.
    match /assignmentKeys/{aid} {
      allow read, write: if isAdmin();
    }

    // The faculty's template file, in base64 chunks (there is no Storage
    // bucket). Readable by anyone signed in, like the brief itself.
    match /assignTemplates/{aid}/chunks/{n} {
      allow read:  if request.auth != null;
      allow write: if isAdmin();
    }

    // Topic board: which topic each group has claimed, first come first
    // served. One document per assignment, readable by every student so they
    // can see what is still free:
    //   taken: { topicId: { sid, gname, at } }
    //   last:  { topicId, sid }   — the claim this write makes
    // A student write may ADD exactly one topic that is not on the board yet,
    // never change or remove one, and only in the same batch that records the
    // topic on their own group's submission. Two groups clicking at once:
    // the second write finds the key already present and is refused.
    match /assignTopicBoards/{aid} {
      allow read: if request.auth != null;
      allow create, delete: if isAdmin();
      allow update: if isAdmin()
        || (isStudentAccount()
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['taken', 'last'])
            && request.resource.data.taken.diff(resource.data.taken).addedKeys().size() == 1
            && request.resource.data.taken.diff(resource.data.taken).addedKeys()
                 .hasOnly([request.resource.data.last.topicId])
            && request.resource.data.taken.diff(resource.data.taken).changedKeys().size() == 0
            && request.resource.data.taken.diff(resource.data.taken).removedKeys().size() == 0
            && asgDoc(aid).get('topicIds', []).hasAny([request.resource.data.last.topicId])
            && request.resource.data.taken[request.resource.data.last.topicId].sid
                 == request.resource.data.last.sid
            && get(subPath(request.resource.data.last.sid)).data.memberUids
                 .hasAny([request.auth.uid])
            && getAfter(subPath(request.resource.data.last.sid)).data.aid == aid
            && getAfter(subPath(request.resource.data.last.sid)).data.topic.id
                 == request.resource.data.last.topicId);
    }

    // Teacher-defined groups: {aid}__{sap} -> the group's id, so a student can
    // find their group without being able to list everyone's. Knowing a group
    // id grants nothing by itself (see assignSubs below).
    match /assignGroupIndex/{id} {
      allow get:         if request.auth != null;
      allow list, write: if isAdmin();
    }

    // A student's profile. The SAP ID cannot be changed once set — only the
    // faculty can correct it.
    match /assignProfiles/{uid} {
      function profileOk() {
        let d = request.resource.data;
        return d.keys().hasOnly(['name', 'sapId', 'mobile', 'email', 'createdAt', 'seenAt'])
               && d.email == request.auth.token.email
               && d.sapId is string && d.sapId.matches('^[A-Za-z0-9]{3,20}$')
               && d.name is string && d.name.size() >= 2 && d.name.size() <= 80
               && d.mobile is string && d.mobile.size() <= 15;
      }
      allow read:   if isAdmin() || (request.auth != null && request.auth.uid == uid);
      allow create: if isStudentAccount() && request.auth.uid == uid && profileOk();
      allow update: if isAdmin()
                    || (isStudentAccount() && request.auth.uid == uid && profileOk()
                        && request.resource.data.sapId == resource.data.sapId);
      allow delete: if isAdmin();
    }

    // Claim: binds one SAP ID to one account for one assignment. Create-only
    // for the student; the faculty can delete it to let the student re-bind
    // (a lost password, or someone who claimed an ID that is not theirs).
    match /assignStudents/{cid} {
      allow get: if isAdmin()
                 || (request.auth != null && resource == null)
                 || (request.auth != null && resource.data.uid == request.auth.uid);
      allow list: if isAdmin();

      allow create: if isStudentAccount()
        && request.resource.data.keys().hasOnly(['aid', 'sapId', 'uid', 'name', 'email',
                                                 'mobile', 'groupId', 'createdAt'])
        && cid == request.resource.data.aid + '__' + request.resource.data.sapId
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.groupId == null
        && get(/databases/$(database)/documents/assignProfiles/$(request.auth.uid))
             .data.sapId == request.resource.data.sapId
        && asgAccepting(request.resource.data.aid)
        && asgRosterOk(request.resource.data.aid, request.resource.data.sapId)
        && asgDomainOk(request.resource.data.aid);

      // The only thing a student changes on their claim is which group it
      // points to — and only in the same batch that actually puts them into
      // (or takes them out of) that group.
      allow update: if isAdmin()
        || (isStudentAccount()
            && resource.data.uid == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['groupId'])
            && ((resource.data.groupId == null
                 && request.resource.data.groupId is string
                 && getAfter(subPath(request.resource.data.groupId)).data.aid == resource.data.aid
                 && getAfter(subPath(request.resource.data.groupId)).data.members
                      .hasAny([resource.data.sapId])
                 && getAfter(subPath(request.resource.data.groupId)).data.memberUids
                      .hasAny([request.auth.uid]))
             || (resource.data.groupId != null
                 && request.resource.data.groupId == null
                 && !getAfter(subPath(resource.data.groupId)).data.members
                      .hasAny([resource.data.sapId]))));
      allow delete: if isAdmin();
    }

    // The submission: one per student (individual) or one per group.
    match /assignSubs/{sid} {
      function isMember() {
        return request.auth != null && resource.data.memberUids.hasAny([request.auth.uid]);
      }
      function actor() {
        return request.resource.data.actor;
      }
      function changed() {
        return request.resource.data.diff(resource.data).affectedKeys();
      }
      // Open for this submission: the assignment is switched on (closing it
      // stops everyone at once, extensions included), and it is before the
      // deadline or before an extension granted to this submission.
      function beforeDeadline() {
        return asgDoc(resource.data.aid).active == true
               && (request.time < asgDoc(resource.data.aid).deadline
                   || (resource.data.get('extensionUntil', null) != null
                       && request.time < resource.data.extensionUntil));
      }

      // Members read their own submission. A group still forming may be read
      // by whoever has its join code (the code IS the document id), so they
      // can see who is in it before joining.
      allow get: if isAdmin()
                 || (request.auth != null && resource == null)
                 || isMember()
                 || (isStudentAccount() && resource.data.kind == 'group'
                     && resource.data.confirmed == false);
      allow list: if isAdmin();

      // Starting: your own individual submission, or a new self-formed group
      // with you as its leader — in the same batch that points your claim at it.
      allow create: if isStudentAccount()
        && request.resource.data.keys().hasOnly(['aid', 'kind', 'formation', 'gname', 'members',
             'memberUids', 'memberNames', 'leader', 'confirmed', 'status', 'answers',
             'wordCounts', 'locks', 'links', 'contrib', 'createdAt',
             'lastEditAt', 'lastEditBy', 'actor', 'revCount'])
        && request.resource.data.status == 'draft'
        && request.resource.data.members == [actor()]
        && request.resource.data.memberUids == [request.auth.uid]
        && request.resource.data.contrib is map
        && request.resource.data.links is list
        && asgAccepting(request.resource.data.aid)
        && ownsClaim(request.resource.data.aid, actor())
        && get(claimPath(request.resource.data.aid, actor())).data.groupId == null
        && getAfter(claimPath(request.resource.data.aid, actor())).data.groupId == sid
        && ((asgDoc(request.resource.data.aid).mode == 'individual'
             && request.resource.data.kind == 'individual'
             && request.resource.data.confirmed == true
             && sid == request.resource.data.aid + '__' + actor())
          || (asgDoc(request.resource.data.aid).mode == 'group'
             && asgDoc(request.resource.data.aid).groupFormation == 'self'
             && request.resource.data.kind == 'group'
             && request.resource.data.formation == 'self'
             && request.resource.data.confirmed == false
             && request.resource.data.leader == actor()
             && sid.matches(request.resource.data.aid + '__g_[a-hj-km-np-z2-9]{8}')));

      // Writing: members only, in their own name, before the deadline (or the
      // extension granted to this submission), while it is still a draft.
      // Contribution statistics are per member, and each member can only
      // touch their own.
      function workUpdate() {
        return isStudentAccount() && isMember()
          && resource.data.members.hasAny([actor()])
          && ownsClaim(resource.data.aid, actor())
          && resource.data.confirmed == true
          && resource.data.status == 'draft'
          && request.resource.data.status in ['draft', 'submitted']
          && (request.resource.data.status == 'draft'
              || request.resource.data.submittedBy == actor())
          && beforeDeadline()
          // An assignment with a topic list is written only once a topic is chosen.
          && (asgDoc(resource.data.aid).get('topicIds', []).size() == 0
              || resource.data.get('topic', null) != null)
          && changed().hasOnly(['answers', 'wordCounts', 'locks', 'links', 'contrib',
                                'lastEditAt', 'lastEditBy', 'actor', 'status',
                                'submittedAt', 'submittedBy', 'revCount'])
          && request.resource.data.contrib.diff(resource.data.contrib)
               .affectedKeys().hasOnly([actor()])
          && request.resource.data.links.size() <= 12;
      }

      // Joining a self-formed group that is still open, with its code.
      function joinUpdate() {
        return isStudentAccount()
          && resource.data.kind == 'group'
          && resource.data.confirmed == false
          && !resource.data.memberUids.hasAny([request.auth.uid])
          && asgAccepting(resource.data.aid)
          && changed().hasOnly(['members', 'memberUids', 'memberNames', 'actor'])
          && request.resource.data.members == resource.data.members.concat([actor()])
          && request.resource.data.memberUids
               == resource.data.memberUids.concat([request.auth.uid])
          && request.resource.data.members.size() <= asgDoc(resource.data.aid).groupMax
          && ownsClaim(resource.data.aid, actor())
          && get(claimPath(resource.data.aid, actor())).data.groupId == null
          && getAfter(claimPath(resource.data.aid, actor())).data.groupId == sid;
      }

      // Taking your place in a group that already lists your SAP ID: a
      // teacher-defined group, or your own group after the faculty reset
      // your account binding.
      function attachUpdate() {
        return isStudentAccount()
          && resource.data.members.hasAny([actor()])
          && !resource.data.memberUids.hasAny([request.auth.uid])
          && changed().hasOnly(['memberUids', 'memberNames', 'actor'])
          && request.resource.data.memberUids
               == resource.data.memberUids.concat([request.auth.uid])
          && ownsClaim(resource.data.aid, actor())
          && getAfter(claimPath(resource.data.aid, actor())).data.groupId == sid;
      }

      // Leaving a self-formed group before it is confirmed. Only the leader
      // can hand the leadership on, and only to someone still in the group.
      function leaveUpdate() {
        return isStudentAccount() && isMember()
          && resource.data.kind == 'group'
          && resource.data.formation == 'self'
          && resource.data.confirmed == false
          && resource.data.members.hasAny([actor()])
          && ownsClaim(resource.data.aid, actor())
          && changed().hasOnly(['members', 'memberUids', 'memberNames', 'leader', 'actor'])
          && request.resource.data.members == resource.data.members.removeAll([actor()])
          && request.resource.data.memberUids
               == resource.data.memberUids.removeAll([request.auth.uid])
          && (actor() == resource.data.leader
              || request.resource.data.leader == resource.data.leader)
          && (request.resource.data.members.size() == 0
              || request.resource.data.members.hasAny([request.resource.data.leader]))
          && getAfter(claimPath(resource.data.aid, actor())).data.groupId == null;
      }

      // The leader closes the group once it is big enough. After this nobody
      // joins or leaves except through the faculty.
      function confirmUpdate() {
        return isStudentAccount() && isMember()
          && resource.data.kind == 'group'
          && resource.data.confirmed == false
          && actor() == resource.data.leader
          && ownsClaim(resource.data.aid, actor())
          && changed().hasOnly(['confirmed', 'confirmedAt', 'actor'])
          && request.resource.data.confirmed == true
          && resource.data.members.size() >= asgDoc(resource.data.aid).groupMin
          && resource.data.members.size() == resource.data.memberUids.size();
      }

      // Choosing the topic: once, by any member, before the deadline. A listed
      // topic must be claimed on the board in the same batch; a topic of the
      // group's own is allowed only when the assignment permits it — by
      // default, once every listed topic has been taken.
      function topicUpdate() {
        return isStudentAccount() && isMember()
          && resource.data.members.hasAny([actor()])
          && ownsClaim(resource.data.aid, actor())
          && resource.data.confirmed == true
          && resource.data.status == 'draft'
          && beforeDeadline()
          && resource.data.get('topic', null) == null
          && changed().hasOnly(['topic', 'actor'])
          && request.resource.data.topic.keys().hasOnly(['id', 'title', 'desc', 'custom',
                                                         'by', 'byName', 'at'])
          && request.resource.data.topic.by == actor()
          && request.resource.data.topic.title is string
          && request.resource.data.topic.title.size() >= 5
          && request.resource.data.topic.title.size() <= 200
          && request.resource.data.topic.desc is string
          && request.resource.data.topic.desc.size() <= 2000
          && ((request.resource.data.topic.custom == false
               && getAfter(boardPath(resource.data.aid)).data.taken[request.resource.data.topic.id].sid
                    == sid)
            || (request.resource.data.topic.custom == true
               && request.resource.data.topic.id == 'own'
               && (asgDoc(resource.data.aid).get('ownTopic', 'whenFull') == 'always'
                   || (asgDoc(resource.data.aid).get('ownTopic', 'whenFull') == 'whenFull'
                       && get(boardPath(resource.data.aid)).data.taken.size()
                            >= asgDoc(resource.data.aid).get('topicIds', []).size()))));
      }

      allow update: if isAdmin() || workUpdate() || joinUpdate()
                    || attachUpdate() || leaveUpdate() || confirmUpdate() || topicUpdate();
      allow delete: if isAdmin();

      // Edit history: one immutable entry per editing session, with a
      // snapshot of the section, written by the member in their own name and
      // stamped with the server's time. This is the timeline the faculty reads
      // to see who wrote what, and when.
      match /revs/{rid} {
        function parent() {
          return get(subPath(sid)).data;
        }
        allow read: if isAdmin()
                    || (request.auth != null && parent().memberUids.hasAny([request.auth.uid]));
        allow create: if isStudentAccount()
          && parent().memberUids.hasAny([request.auth.uid])
          && parent().members.hasAny([request.resource.data.actor])
          && parent().status == 'draft'
          && ownsClaim(parent().aid, request.resource.data.actor)
          && request.resource.data.keys().hasOnly(['actor', 'name', 'qid', 'kind', 'words',
                                                   'wordsBefore', 'typed', 'html', 'at'])
          && request.resource.data.at == request.time
          && request.resource.data.html is string
          && request.resource.data.html.size() <= 100000;
        allow update, delete: if isAdmin();
      }
    }

    // Peer assessment: each group member's split of the work (percent per
    // member) and a statement of their own part. Its own document per member,
    // readable only by its author and the faculty — a declaration team-mates
    // could read would not be an honest one. Open until 72 hours after the
    // deadline, so a group that submits at the last minute can still fill it in.
    match /assignDecls/{did} {
      function sub() {
        return get(subPath(request.resource.data.sid)).data;
      }
      allow get: if isAdmin()
                 || (request.auth != null && resource == null)
                 || (isStudentAccount() && ownsClaim(resource.data.aid, resource.data.sapId));
      allow list: if isAdmin();
      allow create, update: if isStudentAccount()
        && did == request.resource.data.sid + '__' + request.resource.data.sapId
        && request.resource.data.keys().hasOnly(['aid', 'sid', 'sapId', 'split',
                                                 'statement', 'at'])
        && (resource == null || resource.data.sapId == request.resource.data.sapId)
        && ownsClaim(request.resource.data.aid, request.resource.data.sapId)
        && sub().aid == request.resource.data.aid
        && sub().kind == 'group'
        && sub().memberUids.hasAny([request.auth.uid])
        && sub().members.hasAny([request.resource.data.sapId])
        && request.resource.data.split is map
        && request.resource.data.split.size() <= 6
        && request.resource.data.statement is string
        && request.resource.data.statement.size() <= 4000
        && request.resource.data.at == request.time
        && request.time < asgDoc(request.resource.data.aid).deadline
                          + duration.value(72, 'h');
      allow delete: if isAdmin();
    }

    // The faculty's full evaluation of a submission. Faculty only.
    match /assignEvals/{sid} {
      allow read, write: if isAdmin();
    }

    // What each student is shown once marks are released: one document per
    // student, so team-mates never see each other's individual marks.
    match /assignGrades/{gid} {
      allow read: if isAdmin()
                  || (isStudentAccount()
                      && ownsClaim(resource.data.aid, resource.data.sapId)
                      && asgDoc(resource.data.aid).get('marksReleased', false) == true);
      allow write: if isAdmin();
    }
  }
}
